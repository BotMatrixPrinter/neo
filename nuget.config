<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only. Every package version is pinned exactly, so a restore that already has
       them in its global packages folder (e.g. an offline cache) never touches the network. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
